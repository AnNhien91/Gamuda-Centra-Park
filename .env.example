# Sao chép thành file .env (KHÔNG đưa .env lên GitHub)
PORT=3000
NODE_ENV=production

# --- Gửi email khi có khách đăng ký (tuỳ chọn) ---
# Email Hostinger: smtp.hostinger.com, cổng 465, SSL
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@yourdomain.com
SMTP_PASS=
SMTP_FROM="Gamuda Central Park <no-reply@yourdomain.com>"
LEAD_EMAIL_TO=sales@yourdomain.com

# --- Đẩy lead vào Google Sheets (tuỳ chọn) ---
# Xem hướng dẫn trong google-apps-script/Code.gs
SHEETS_WEBHOOK_URL=

# --- Chỉ dùng cho bản build tĩnh (npm run build) ---
# Để trống nếu chạy server Node.js. Với hosting thường, điền URL Google Apps Script.
FORM_ENDPOINT=
